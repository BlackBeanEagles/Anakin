# ============================================================
#  MODEL PROVIDER  —  pick one: groq | gemini | anthropic | mock
# ============================================================
LLM_PROVIDER=groq

# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paid: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional override. Leave blank to use the provider's default:
#   groq       openai/gpt-oss-120b
#   gemini     gemini-2.0-flash
#   anthropic  claude-opus-5
LLM_MODEL=

# ============================================================
#  SAFETY
# ============================================================
# DRY_RUN=true means NOTHING leaves this machine. Emails are written to outbox/.
# Flip to false only when you are ready to contact real departments.
DRY_RUN=true

# ============================================================
#  DEMO TIME COMPRESSION
# ============================================================
# Real ladder waits are in days. TIME_SCALE shrinks them so you can watch the whole
# escalation ladder run in minutes while testing.
#   1.0      = real time (21 days really means 21 days)
#   0.0001   = 21 days becomes ~3 minutes   <-- good for demo/testing
TIME_SCALE=0.0001
TICK_SECONDS=20

# ============================================================
#  CONSOLE  (the approval gate)
# ============================================================
CONSOLE_PASSWORD=changeme

# ============================================================
#  OUTBOUND EMAIL  (only used when DRY_RUN=false)
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ============================================================
#  INBOUND EMAIL  (department replies auto-ingested)
# ============================================================
# Leave blank to disable. With Gmail, use an App Password, not your login password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=120

# ============================================================
#  WHATSAPP INTAKE  (Twilio)
# ============================================================
# Point Twilio's inbound webhook at  https://<host>/webhook/whatsapp
# Without this token the endpoint refuses everything rather than trusting unsigned posts.
TWILIO_AUTH_TOKEN=

# ============================================================
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------- Anakin.io
# The web-data API Persist reads through. Free tier is 300 credits; get a key at
# https://anakin.io. Without one the app still runs - it just falls back to a plain
# HTTP GET, which the captcha-gated pages refuse.
ANAKIN_API_KEY=

# direct | auto | anakin
#   direct  our own client only. Free, blind to gated pages.
#   auto    direct first, Anakin only when that read fails. The default: pages that
#           were readable anyway cost nothing, which is how 300 credits last a week.
#   anakin  every read through Anakin. A credit per page - for demonstrating the
#           integration deliberately, not for running the queue.
WEB_BACKEND=auto

# Proxy exit country. These are Indian government sites; asking for pgportal.gov.in
# from an Ohio datacentre is a good way to look like a bot.
ANAKIN_COUNTRY=in

# Self-imposed ceiling, enforced before any paid call goes out, kept under the 300
# free credits so a runaway tick cannot burn the budget the demo depends on.
# A scrape is 1 credit; a Wire build request is 25.
ANAKIN_CREDIT_BUDGET=260

# Retry a failed scrape in a real headless browser. Costs no extra credits, only
# latency - India Post's tracking form does not render without it.
ANAKIN_BROWSER_FALLBACK=true
