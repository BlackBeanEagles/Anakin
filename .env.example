# ============================================================
#  MODEL PROVIDER  —  pick one: groq | gemini | anthropic | mock
# ============================================================
LLM_PROVIDER=groq

# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paid: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional override. Leave blank to use the provider's default:
#   groq       llama-3.3-70b-versatile
#   gemini     gemini-2.0-flash
#   anthropic  claude-opus-5
LLM_MODEL=

# ============================================================
#  SAFETY
# ============================================================
# DRY_RUN=true means NOTHING leaves this machine. Emails are written to outbox/.
# Flip to false only when you are ready to contact real departments.
DRY_RUN=true

# ============================================================
#  DEMO TIME COMPRESSION
# ============================================================
# Real ladder waits are in days. TIME_SCALE shrinks them so you can watch the whole
# escalation ladder run in minutes while testing.
#   1.0      = real time (21 days really means 21 days)
#   0.0001   = 21 days becomes ~3 minutes   <-- good for demo/testing
TIME_SCALE=0.0001
TICK_SECONDS=20

# ============================================================
#  CONSOLE  (the approval gate)
# ============================================================
CONSOLE_PASSWORD=changeme

# ============================================================
#  OUTBOUND EMAIL  (only used when DRY_RUN=false)
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ============================================================
#  INBOUND EMAIL  (department replies auto-ingested)
# ============================================================
# Leave blank to disable. With Gmail, use an App Password, not your login password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=120

# ============================================================
#  WHATSAPP INTAKE  (Twilio)
# ============================================================
# Point Twilio's inbound webhook at  https://<host>/webhook/whatsapp
# Without this token the endpoint refuses everything rather than trusting unsigned posts.
TWILIO_AUTH_TOKEN=

# ============================================================
PUBLIC_BASE_URL=http://127.0.0.1:8000
